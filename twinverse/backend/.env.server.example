# SERVER ONLY. Copy to .env.server; npm run serve:student loads it.
# AWS/Cognito event identifiers are currently configured in source, not here.
# Optional voice: this placeholder must be resolved by your authorized server-side
# secret workflow (e.g. asm-exec). It is intentionally not a usable API key.
ELEVENLABS_API_KEY={{resolve:secretsmanager:twinverse/event/elevenlabs:SecretString:apiKey}}
ELEVENLABS_VOICE_ID=
ENABLE_STUDENT_DEVELOPMENT_PREVIEW=true
ENABLE_FACULTY_DEVELOPMENT=true
# Enable only after reviewing and deploying private document storage.
ENABLE_PATIENT_FILES=false
# Optional path for the legacy import utilities:
# TWINVERSE_CHALLENGE_PACKAGE=/path/to/challenge.zip
